terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0, < 7.0"
    }
  }
}

provider "google" {
  # Uses Application Default Credentials (ADC).
  # Run: gcloud auth application-default login
  region = var.region
}
